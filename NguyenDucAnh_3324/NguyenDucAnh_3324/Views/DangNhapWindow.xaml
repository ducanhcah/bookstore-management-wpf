<Window x:Class="NguyenDucAnh_3324.Views.DangNhapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập - QL Nhà Sách" Height="260" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ĐĂNG NHẬP HỆ THỐNG" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,15" Grid.Row="0"/>

        <Grid Grid.Row="0" Margin="0,35,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Content="Tên đăng nhập" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                     Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Mật khẩu" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
            <PasswordBox x:Name="pwd" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                         PasswordChanged="pwd_PasswordChanged"/>
        </Grid>

        <Button Content="Đăng nhập" Grid.Row="4" Width="120" Height="35"
                HorizontalAlignment="Center" Command="{Binding DangNhapCommand}"/>
    </Grid>
</Window>
