<Window x:Class="NguyenDucAnh_3324.Views.LapHoaDonWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Lập hoá đơn bán sách" Height="700" Width="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- THÔNG TIN HÓA ĐƠN -->
        <GroupBox Header="Thông tin hoá đơn" FontSize="18" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Mã HĐ" Grid.Column="0" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <TextBox Grid.Column="1" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" Text="{Binding MaHD, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Ngày lập" Grid.Column="2" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <DatePicker Grid.Column="3" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" SelectedDate="{Binding NgayLap}"/>
                <Label Content="Khách hàng" Grid.Column="4" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <TextBox Grid.Column="5" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" Text="{Binding TenKH, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </GroupBox>
        <!-- THÊM SÁCH -->
        <GroupBox Header="Thêm sách vào hoá đơn" FontSize="18" Grid.Row="1" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Chọn sách" Grid.Column="0" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <ComboBox Grid.Column="1" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" ItemsSource="{Binding DsSach}" DisplayMemberPath="TenSach" SelectedItem="{Binding SachChonThem}"/>
                <Label Content="SL" Grid.Column="2" FontSize="14" VerticalAlignment="Center" HorizontalContentAlignment="Center" Padding="0"/>
                <TextBox Grid.Column="3" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" Text="{Binding SoLuongThem, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Đơn giá" Grid.Column="4" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <TextBox Grid.Column="5" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" IsReadOnly="True" Text="{Binding DonGiaThem, Mode=OneWay, StringFormat=N0}"/>
                <Button Content="Thêm dòng" Grid.Column="6" Width="110" Height="32" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5" Command="{Binding ThemDongCommand}"/>
            </Grid>
        </GroupBox>
        <!-- CHI TIẾT HÓA ĐƠN -->
        <GroupBox Header="Chi tiết hoá đơn" FontSize="18" Grid.Row="2">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="45"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" FontSize="14" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding DsChiTiet}" SelectedItem="{Binding DongDangChon}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="35"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã sách" Binding="{Binding MaSach}" Width="100"/>
                        <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" Width="*"/>
                        <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="100"/>
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat=N0}" Width="130"/>
                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat=N0}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="Xoá dòng" Grid.Row="1" Width="100" Height="32" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding XoaDongCommand}"/>
            </Grid>
        </GroupBox>
        <!-- TỔNG TIỀN + LƯU -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding TongTien, StringFormat='Tổng tiền: {0:N0} đ'}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Lưu hoá đơn" Width="130" Height="38" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding LuuHoaDonCommand}"/>
        </Grid>
    </Grid>
</Window>