<Window x:Class="NguyenDucAnh_3324.Views.QuanLySachWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quản lý Sách" Height="850" Width="1020" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- THÔNG TIN SÁCH -->
        <GroupBox Header="Thông tin Sách" FontSize="18" Grid.Row="0" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                </Grid.RowDefinitions>
                <!-- HÀNG 1 -->
                <Label Content="Mã sách" Grid.Row="0" Grid.Column="0" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <TextBox Grid.Row="0" Grid.Column="1" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" Text="{Binding MaSach, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Tên sách" Grid.Row="0" Grid.Column="2" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <TextBox Grid.Row="0" Grid.Column="3" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" Text="{Binding TenSach, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Tác giả" Grid.Row="0" Grid.Column="4" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <TextBox Grid.Row="0" Grid.Column="5" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" Text="{Binding TacGia, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- HÀNG 2 -->
                <Label Content="Thể loại" Grid.Row="1" Grid.Column="0" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" ItemsSource="{Binding DsTheLoai}" DisplayMemberPath="TenTL" SelectedItem="{Binding TheLoaiDangChon}"/>
                <Label Content="Ngày nhập" Grid.Row="1" Grid.Column="2" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <DatePicker Grid.Row="1" Grid.Column="3" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" SelectedDate="{Binding NgayNhap}"/>
                <Label Content="Số lượng" Grid.Row="1" Grid.Column="4" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <TextBox Grid.Row="1" Grid.Column="5" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" Text="{Binding SoLuong, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- HÀNG 3 -->
                <Label Content="Đơn giá" Grid.Row="2" Grid.Column="0" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <TextBox Grid.Row="2" Grid.Column="1" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" Text="{Binding DonGia, UpdateSourceTrigger=PropertyChanged}"/>
                <Label Content="Lọc thể loại" Grid.Row="2" Grid.Column="2" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <ComboBox Grid.Row="2" Grid.Column="3" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" ItemsSource="{Binding DsTheLoai}" DisplayMemberPath="TenTL" SelectedItem="{Binding TheLoaiLoc}"/>
                <Label Content="Tìm tên sách" Grid.Row="2" Grid.Column="4" FontSize="14" VerticalAlignment="Center" Padding="0"/>
                <TextBox Grid.Row="2" Grid.Column="5" Height="32" FontSize="14" VerticalContentAlignment="Center" Margin="5" Text="{Binding TuKhoaTim, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </GroupBox>
        <!-- CHỨC NĂNG -->
        <GroupBox Header="Chức năng" FontSize="18" Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                <Button Content="Thêm" Width="80" Height="35" Margin="5" FontSize="14" Command="{Binding ThemCommand}"/>
                <Button Content="Sửa" Width="80" Height="35" Margin="5" FontSize="14" Command="{Binding SuaCommand}"/>
                <Button Content="Xoá" Width="80" Height="35" Margin="5" FontSize="14" Command="{Binding XoaCommand}"/>
                <Button Content="Tìm" Width="80" Height="35" Margin="5" FontSize="14" Command="{Binding TimCommand}"/>
                <Button Content="Làm mới" Width="80" Height="35" Margin="5" FontSize="14" Command="{Binding LamMoiCommand}"/>
                <Button Content="Đếm" Width="80" Height="35" Margin="20,5,5,5" FontSize="14" Command="{Binding DemCommand}"/>
                <TextBox Width="80" Height="35" Margin="5" FontSize="14" IsReadOnly="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="{Binding KetQuaDem, Mode=OneWay}"/>
                <Button Content="Lập hoá đơn &gt;&gt;" Width="140" Height="35" Margin="25,5,5,5" FontSize="14" Command="{Binding MoLapHoaDonCommand}"/>
            </StackPanel>
        </GroupBox>
        <!-- DỮ LIỆU -->
        <GroupBox Header="Dữ Liệu" FontSize="18" Grid.Row="2">
            <DataGrid Name="dg_Sach" Margin="5" FontSize="14" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding ViewDsSach}" SelectedItem="{Binding SachDangChon}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,5"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="35"/>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã sách" Binding="{Binding MaSach}" Width="100"/>
                    <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" Width="*"/>
                    <DataGridTextColumn Header="Tác giả" Binding="{Binding TacGia}" Width="180"/>
                    <DataGridTextColumn Header="Mã TL" Binding="{Binding MaTL}" Width="80"/>
                    <DataGridTextColumn Header="Ngày nhập" Binding="{Binding NgayNhap, StringFormat=dd/MM/yyyy}" Width="120"/>
                    <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="100"/>
                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat=N0}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>